# Salin file ini menjadi ".env" di folder yang sama, lalu isi nilainya.
# JANGAN commit file ".env" (sudah ada di .gitignore).

# ---- Database (WAJIB) ----
# Connection string PostgreSQL. Untuk Neon (https://neon.tech):
# 1. Buat project baru (gratis untuk skala kecil/portofolio).
# 2. Buka tab "Connection Details" / "Connection string".
# 3. Salin connection string yang sudah menyertakan "?sslmode=require".
# Contoh format:
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# ---- Auth (WAJIB untuk produksi/Vercel) ----
# Kunci penandatanganan JWT. Isi dengan string acak yang panjang, mis.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Jika dikosongkan di dev lokal (Termux), server otomatis membuat file
# server/data/.jwt-secret sebagai fallback - TAPI di Vercel WAJIB diisi
# lewat dashboard project karena filesystem di sana tidak persisten.
JWT_SECRET=

# ---- Server (opsional) ----
# Port HTTP untuk dev lokal (Termux/laptop). Tidak dipakai di Vercel.
PORT=3000

# ---- Kunci sekali pakai / One-Time Key (WAJIB bila fitur Admin / level Master+ dipakai) ----
# Rahasia bersama untuk 4 jenis kunci (Master, Grandmaster, Super Grandmaster,
# Admin Settings) - lihat server/lib/one-time-keys.js. Kunci dibuat oleh
# halaman generator (keygeneratora1b2/index.html) dan HARUS memakai rahasia yang
# SAMA: isi nilai ini persis (tanpa spasi tambahan) di kolom "Rahasia
# penandatangan" pada halaman generator. Rahasia dipakai sebagai TEKS apa
# adanya, bukan di-decode dari hex. Minimal 16 karakter. TIDAK ADA nilai
# bawaan: bila kosong atau lebih pendek, server menolak SEMUA kunci (fitur
# Admin dan level Master/Grandmaster/Super GM terkunci; pemain lain tidak
# terpengaruh). Contoh membuat nilai acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ONE_TIME_KEY_SECRET=

# ---- Keamanan tambahan (semua OPSIONAL; default aman/kompatibel) ----
# Daftar asal (domain frontend) yang boleh memanggil API, dipisah koma, tanpa
# garis miring akhir. Contoh: https://nusantara-chess.vercel.app
# Kosong = semua asal diizinkan (perilaku lama; server mencetak peringatan di
# produksi). Saat DIISI: localhost & IP LAN tetap diizinkan selama BUKAN produksi
# (jadi pengembangan di Termux tidak terganggu).
CORS_ORIGINS=
# [ANTI-CLONING] DI PRODUKSI WAJIB diisi dengan domain frontend resmi (pisahkan koma), mis.
#   CORS_ORIGINS=https://nusantara-chess.vercel.app
# Kosong = API terbuka untuk semua asal, sehingga salinan frontend di domain lain tetap bisa memakai API-mu.
# Masa berlaku token sesi (format jsonwebtoken: 7d, 12h, ...). Default 14d.
JWT_TTL=
# Isi 1 HANYA bila server berada di belakang reverse proxy tepercaya (Nginx,
# Cloudflare) supaya IP asli klien dibaca dari X-Forwarded-For untuk rate
# limit. Di Vercel sudah otomatis. Jangan diisi bila server menerima koneksi
# langsung dari internet (header itu bisa dipalsukan klien).
TRUST_PROXY=
# Verifikasi sertifikat TLS database: di produksi SELALU aktif. Isi 1 untuk ikut
# memverifikasi di dev; DB_SSL_INSECURE=1 mematikannya (darurat saja, mis. Postgres
# dengan sertifikat self-signed).
DB_SSL_STRICT=
DB_SSL_INSECURE=
